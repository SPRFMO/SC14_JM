+.subsetYPR = function(ypr, stock) {
+  if(is.null(ypr) || !"Stock" %in% names(ypr)) return(ypr)
+  
+  stockRows = ypr$Stock == stock
+  stockRows[is.na(stockRows)] = FALSE
+  
+  ypr = ypr[stockRows, names(ypr) != "Stock", drop = FALSE]
+  rownames(ypr) = NULL
+  
+  return(ypr)
+}
+
